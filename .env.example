# Backend origin — server-side only (route handlers / RSC), never sent to the browser.
API_URL=http://localhost:8000
# Browser-visible base path: all client fetches go through the Next proxy route.
NEXT_PUBLIC_API_URL=/api/proxy
# The marketing site (SPEC-320): the pricing page links back to it (Product, Privacy, Terms).
MARKETING_URL=https://ftes.ai/commerce
# SPEC-340: "Continue with …" on login and sign-up. Google shows unless exactly false;
# Shopify stays hidden unless exactly true.
NEXT_PUBLIC_GOOGLE_SIGN_IN=true
NEXT_PUBLIC_SHOPIFY_SIGN_IN=false
